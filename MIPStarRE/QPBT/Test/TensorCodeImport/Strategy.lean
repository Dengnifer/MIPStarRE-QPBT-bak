import MIPStarRE.QPBT.Test.TensorCodeImport.PairState
import MIPStarRE.QPBT.Test.TensorCodeImport.Weights
import MIPStarRE.QPBT.Combining.DirectLowDegree.Transport.Combining.Answers

/-!
# The Reed--Solomon tensor-test strategy

The answer on an axis line is an actual evaluation word of a polynomial of
degree at most `d`. Canonical source line parameters are translated to the
coordinate parameter used by the tensor test. Points and axis lines ignore
the pair register; the pair family reads it as in `PairMeasurement`.

Axis lines are labelled in the source coordinate chart. Their geometric
points in the tensor test have the coordinates reversed, just as pair and
point questions do. The label contains no seed or hidden subcube index.

## References

- `references/qpbt-paper/08_classical_and_quantum_low_degree_tests.tex:443-458`
- Ji et al., arXiv:2111.08131v3, Figures 1--2 and Definition 4.5.
- `docs/paper-gaps/qpbt_ld-dimension-divisibility.tex`, import obligations (#704).
- Blueprint `prop:tensor-import-pair-sampling`.
-/

namespace MIPStarRE.QPBT.TensorCodeImport

open MIPStarRE.LDT hiding Measurement
open MIPStarRE.Quantum

noncomputable section

/-- Field-valued points in the tensor code's reversed coordinate chart. -/
abbrev TensorPoint (D : DirectLdParams) := Fin D.m → DirectScalarQ D

/-- Reed--Solomon codewords are functions admitting a polynomial
representative of degree at most `d`, not coefficient vectors. -/
abbrev ReedSolomonWord (D : DirectLdParams) :=
  {word : DirectScalarQ D → DirectScalarQ D //
    ∃ p : Polynomial (DirectScalarQ D), p.natDegree ≤ D.d ∧ ∀ t, p.eval t = word t}

instance (D : DirectLdParams) : Fintype (ReedSolomonWord D) := Fintype.ofFinite _

instance (D : DirectLdParams) : DecidableEq (ReedSolomonWord D) := Classical.decEq _

/-- The zero evaluation word, also used to complete malformed source answers. -/
def zeroWord (D : DirectLdParams) : ReedSolomonWord D :=
  ⟨0, 0, by simp⟩

/-- A canonical axis line, labelled before coordinate reversal. -/
abbrev AxisQuestion (D : DirectLdParams) :=
  {line : DirectLineDesc D // line.kind = .axis}

instance (D : DirectLdParams) : Fintype (AxisQuestion D) := Fintype.ofFinite _

instance (D : DirectLdParams) : DecidableEq (AxisQuestion D) := Classical.decEq _

/-- The visible axis line generated by a uniform source sample. -/
def axisQuestion (D : DirectLdParams) (sample : DirectLdSpace D) : AxisQuestion D :=
  ⟨directALineDescOf D sample, rfl⟩

/-- The tensor-test data of Definition 4.5, with separate measurement
families for the two players. Projectivity is recorded separately so that
the rejection calculation also applies to arbitrary source POVMs. -/
structure TensorCodeStrategy (D : DirectLdParams) where
  ιA : Type
  ιB : Type
  [fintypeA : Fintype ιA]
  [fintypeB : Fintype ιB]
  [decidableA : DecidableEq ιA]
  [decidableB : DecidableEq ιB]
  ψ : EuclideanSpace ℂ (ιA × ιB)
  ψ_norm : ‖ψ‖ = 1
  pointA : TensorPoint D → Measurement (DirectScalarQ D) ιA
  pointB : TensorPoint D → Measurement (DirectScalarQ D) ιB
  axisA : AxisQuestion D → Measurement (ReedSolomonWord D) ιA
  axisB : AxisQuestion D → Measurement (ReedSolomonWord D) ιB
  pairA : PairQuestion D → Measurement (DirectScalarQ D × DirectScalarQ D) ιA
  pairB : PairQuestion D → Measurement (DirectScalarQ D × DirectScalarQ D) ιB

attribute [instance] TensorCodeStrategy.fintypeA TensorCodeStrategy.fintypeB
  TensorCodeStrategy.decidableA TensorCodeStrategy.decidableB

/-- All six measurement families are projective, as required by Definition 4.5. -/
def TensorCodeStrategy.IsProjective {D : DirectLdParams} (T : TensorCodeStrategy D) : Prop :=
  (∀ u, MIPStarRE.QPBT.Measurement.IsProjective (T.pointA u)) ∧
  (∀ u, MIPStarRE.QPBT.Measurement.IsProjective (T.pointB u)) ∧
  (∀ l, MIPStarRE.QPBT.Measurement.IsProjective (T.axisA l)) ∧
  (∀ l, MIPStarRE.QPBT.Measurement.IsProjective (T.axisB l)) ∧
  (∀ p, MIPStarRE.QPBT.Measurement.IsProjective (T.pairA p)) ∧
  (∀ p, MIPStarRE.QPBT.Measurement.IsProjective (T.pairB p))

/-- Read one source point coordinate. Malformed source answers are completed
to zero; rejection comparisons below must retain their original mass. -/
def pointReadout (D : DirectLdParams) (r : Fin D.k) : DirectLdAnswer D → DirectScalarQ D :=
  fun answer => directLdPointValuesOrZero D answer r

/-- Translate an axis answer from its canonical affine parameter to the
varying coordinate of the geometric line, then take its evaluation word. -/
def axisReadout (D : DirectLdParams) (r : Fin D.k) (line : AxisQuestion D) :
    DirectLdAnswer D → ReedSolomonWord D
  | .alinePolys f =>
      ⟨fun t => evalCoefficient (f r) (t - line.val.base line.val.index),
        shiftedLinePolynomial (f r) (-line.val.base line.val.index),
        shiftedLinePolynomial_natDegree_le _ _, by
          intro t
          simpa [sub_eq_add_neg] using shiftedLinePolynomial_eval
            (f r) (-line.val.base line.val.index) t⟩
  | _ => zeroWord D

/-- A point measurement with a register-independent source question. -/
def pointMeasurement (D : DirectLdParams) (r : Fin D.k)
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (M : DirectLdQuestion D → Measurement (DirectLdAnswer D) ι) (u : TensorPoint D) :
    Measurement (DirectScalarQ D) (ι × PairRegister D) :=
  blockDiagonalMeasurement fun _ =>
    (M (directLdPointQuestionOf D (fun j => u j.rev))).postprocess (pointReadout D r)

/-- An axis measurement with genuine codeword outcomes and no hidden seed. -/
def axisMeasurement (D : DirectLdParams) (r : Fin D.k)
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (M : DirectLdQuestion D → Measurement (DirectLdAnswer D) ι) (line : AxisQuestion D) :
    Measurement (ReedSolomonWord D) (ι × PairRegister D) :=
  blockDiagonalMeasurement fun _ =>
    (M (.aline, ⟨line.val.base, line.val.index, 0⟩)).postprocess (axisReadout D r line)

/-- Construct all tensor-test measurements and their normalized correlated
state from a direct strategy, reading one simultaneous answer coordinate. -/
def tensorCodeStrategyOfDirectLd (D : DirectLdParams) (S : Strategy (directLdGame D))
    (r : Fin D.k) : TensorCodeStrategy D where
  ιA := S.ιA × PairRegister D
  ιB := S.ιB × PairRegister D
  ψ := correlatedPairState D S
  ψ_norm := correlatedPairState_norm D S
  pointA := pointMeasurement D r S.A
  pointB := pointMeasurement D r S.B
  axisA := axisMeasurement D r S.A
  axisB := axisMeasurement D r S.B
  pairA := pairMeasurement D r S.A
  pairB := pairMeasurement D r S.B

/-- The actual source-to-tensor strategy: first retain the source seed in
the established correlated residue register, then adjoin the pair register. -/
def tensorCodeStrategyOfLd (L : LdParams) (S : Strategy (ldGame L))
    (r : Fin L.k) : TensorCodeStrategy L.toDirectLdParams :=
  tensorCodeStrategyOfDirectLd L.toDirectLdParams (ldStrategyToDirect L S) r

/-- The complete strategy construction preserves projectivity. This is a
construction theorem, with no passing-value or soundness assumption. -/
theorem tensorCodeStrategyOfDirectLd_isProjective (D : DirectLdParams)
    (S : Strategy (directLdGame D)) (hS : S.IsProjective) (r : Fin D.k) :
    (tensorCodeStrategyOfDirectLd D S r).IsProjective := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro u
    exact blockDiagonalMeasurement_isProjective _ fun _ =>
      SandwichProduct.postprocess_isProjective _ (hS.1 _) _
  · intro u
    exact blockDiagonalMeasurement_isProjective _ fun _ =>
      SandwichProduct.postprocess_isProjective _ (hS.2 _) _
  · intro line
    exact blockDiagonalMeasurement_isProjective _ fun _ =>
      SandwichProduct.postprocess_isProjective _ (hS.1 _) _
  · intro line
    exact blockDiagonalMeasurement_isProjective _ fun _ =>
      SandwichProduct.postprocess_isProjective _ (hS.2 _) _
  · exact pairMeasurement_isProjective D r S.A hS.1
  · exact pairMeasurement_isProjective D r S.B hS.2

/-- The source-to-tensor construction preserves projectivity through both
the seed-residue register and the compatible-pair register. -/
theorem tensorCodeStrategyOfLd_isProjective (L : LdParams)
    (S : Strategy (ldGame L)) (hS : S.IsProjective) (r : Fin L.k) :
    (tensorCodeStrategyOfLd L S r).IsProjective :=
  tensorCodeStrategyOfDirectLd_isProjective L.toDirectLdParams (ldStrategyToDirect L S)
    (ldStrategyToDirect_isProjective L S hS) r

end

end MIPStarRE.QPBT.TensorCodeImport
